#!/bin/sh
set -eu
if [ ! -f settings.gradle ]; then
    echo 'Run scripts/dev from spotlight root.' >&2
    exit 1
fi
if [ -z "${JAVA_HOME:-}" ]; then
    for home in .jdk/Contents/Home .jdk "$HOME/Library/Application Support/PrismLauncher/java/java-runtime-epsilon/jre.bundle/Contents/Home"; do
        if [ -x "$home/bin/javac" ]; then
            JAVA_HOME="$home"
            break
        fi
    done
fi
: "${JAVA_HOME:?Set JAVA_HOME to JDK 25 or newer; /usr/bin/java has no default runtime.}"
export JAVA_HOME
PATH="$JAVA_HOME/bin:$PATH"
export PATH
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$PWD/.gradle-user-home}"
export GRADLE_USER_HOME
mkdir -p "$GRADLE_USER_HOME/tmp"
JAVA_TOOL_OPTIONS="${JAVA_TOOL_OPTIONS:-} -Djava.io.tmpdir=$GRADLE_USER_HOME/tmp"
export JAVA_TOOL_OPTIONS
if [ "$#" -eq 0 ]; then
    set -- runClient -PclientDebug
fi
exec ./gradlew "$@"
